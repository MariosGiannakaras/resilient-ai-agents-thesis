* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

research/bibliography/** linguist-generated=true

